    "check:docs": "node scripts/check-readme-parity.mjs",
    "check:release": "node scripts/check-release-manifest.mjs",
    "test:publication": "node --test scripts/publication.test.mjs",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.82.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@next/eslint-plugin-next": "16.2.11",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
